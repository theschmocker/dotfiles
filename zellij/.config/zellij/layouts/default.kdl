layout {
	default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:compact-bar" {
				tooltip "F1"
			}
        }
		children
	}

    tab name="nvim" focus=true hide_floating_panes=true {
        pane focus=true {}
    }
    tab name="term" hide_floating_panes=true {
        pane
    }
    tab name="par" hide_floating_panes=true {
        pane
    }
}

